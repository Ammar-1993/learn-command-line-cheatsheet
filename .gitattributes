# ==============================================================================
# Git Attributes Configuration
# يضمن هذا الملف توحيد نهايات الأسطر (LF) لجميع ملفات سكربتات Bash والملفات
# النصية، لمنع خطأ ($'\r': command not found) عند التشغيل في Git Bash أو WSL.
# ==============================================================================

# التعرّف التلقائي على الملفات النصية وتوحيد نهايات أسطرها عند الرفع إلى Git
* text=auto

# إلزام Git باستخدام نهايات أسطر LF دائماً لملفات Bash Scripts
*.sh text eol=lf

# الحفاظ على نهايات أسطر LF لملفات التوثيق وتطوير الويب
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# ملفات الأوامر الخاصة بويندوز فقط تحتفظ بـ CRLF في حال إضافتها مستقبلاً
*.bat text eol=crlf
*.cmd text eol=crlf

# تحديد الملفات الثنائية (Binary) حتى لا يقوم Git بتعديل محتواها إطلاقاً
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
